@@ -95,6 +95,13 @@ module frame_mem_if #(
     // ================= DDR side (ui_clk domain) =================
     input  wire         ui_clk,
     input  wire         ui_rst_n,
+    // ★B1 (2026-11-07 dma-stall): ui 域 **FIFO 侧**复位, 必须与 user_rst_n 成对。
+    //   缺陷: 二者原本分接 ~aurora_rst / ui_rst_n, Aurora 闪断时只有一侧指针归零,
