# [A2] 邮箱看门狗 + 单驱动错误脉冲（插在写通道 localparam 之前, 约 :163）
# ---------------------------------------------------------------------------
+    //=========================================================================
+    // round3d: 4 相邮箱看门狗（DRAFT）。正常往返 <100 aclk；4096 aclk=41us 判死等。
+    //=========================================================================
+    localparam [11:0] MBOX_WD_MAX = 12'hFFF;
+    reg [11:0] lr_wd, lw_wd;           // 读/写通道非 IDLE 停留计数
+    reg        lr_to, lw_to;           // 超时单拍标志（IDLE 清）
+    reg        lr_err_req, lw_err_req; // 单拍"错误请求"，由本 FSM 置、错误块消费
+    reg        mbox_clr_tog;           // aclk -> clk_user 清邮箱翻转事件（单驱动块）
+    reg  [1:0] mbox_fault;             // sticky: [0]=读超时 [1]=写超时（单驱动块）
+
+    // round3d: 单驱动错误聚合块（坑 #25：同一 reg 不得被两个 always 写）
+    always @(posedge aclk) begin
+        if (!aresetn) begin
+            mbox_fault   <= 2'd0;
+            mbox_clr_tog <= 1'b0;
+        end else begin
+            if (lr_err_req) mbox_fault[0] <= 1'b1;
+            if (lw_err_req) mbox_fault[1] <= 1'b1;
+            // 两个通道同拍出错只翻转一次（XOR 合并，避免 ++ 再 ++ 相互抵消）
+            mbox_clr_tog <= mbox_clr_tog ^ (lr_err_req ^ lw_err_req);
+        end
+    end

